# Environment for `ollama serve`, loaded by scripts/run-server.sh.
# Edit -> commit -> push: the Mac Studio picks this up within ~60s and
# restarts the server automatically (in-flight requests are dropped).

# Listen on all interfaces so other machines on your LAN can reach it.
OLLAMA_HOST=0.0.0.0:11434

# Let browser pages call the API cross-origin - required for the bundled
# test page (web/), which talks to :11434 from :8080. Tighten to explicit
# origins if you prefer; see the Security section of the README.
OLLAMA_ORIGINS=*

# Keep the last-used model resident in memory indefinitely (-1) so requests
# never pay a cold-load. Use a duration like "30m" to allow unloading.
OLLAMA_KEEP_ALIVE=-1

# Default context window (tokens) for models that don't set their own.
OLLAMA_CONTEXT_LENGTH=32768

# Concurrent requests a single loaded model will serve.
OLLAMA_NUM_PARALLEL=2

# With 256 GB unified memory you can keep two models resident
# (e.g. a big general model + a fast coding model).
OLLAMA_MAX_LOADED_MODELS=2

# Flash attention + quantized KV cache: large memory savings at long context.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0

# ---- web test page (read by scripts/run-web.sh, not by ollama) ----
# Port for the browser test page served from web/.
INFERENCE_WEB_PORT=8080

# ---- sync behaviour (read by scripts/apply.sh, not by ollama) ----
# If "true", models on disk that are no longer listed in config/models.txt
# are deleted during apply. Off by default so a typo can't wipe a 100 GB pull.
INFERENCE_PRUNE_MODELS=false
